<?xml version="1.0"?>
<ruleset name="visual-block-picker">
    <description>PSR-2 with the usual SilverStripe exceptions</description>

    <file>src</file>

    <arg value="sp"/>
    <arg name="colors"/>

    <rule ref="PSR2">
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <exclude name="Squiz.Classes.ValidClassName.NotCamelCaps"/>
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
    </rule>
</ruleset>
